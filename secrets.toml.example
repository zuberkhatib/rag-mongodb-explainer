# OPTIONAL. The app works without any of this (demo mode).
#
# To turn on live mode on Streamlit Community Cloud:
#   your app -> ⋮ menu -> Settings -> Secrets -> paste the lines below with your real values -> Save
# To use locally instead: copy this file to .streamlit/secrets.toml (that path is in .gitignore).
# NEVER put real keys in a file you commit to GitHub.

# Real Claude answers (from platform.claude.com, billed per use)
ANTHROPIC_API_KEY = "sk-ant-..."

# Real search over the Atlas collection your load_data.py created
MONGODB_URI = "mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/"
VOYAGE_API_KEY = "pa-..."

# Strongly recommended for a public app: visitors must type this code before live mode
# switches on, so strangers can't spend your API credit.
LIVE_ACCESS_CODE = "choose-a-code"

# Optional: which Claude model to use (default claude-opus-5-5)
# CLAUDE_MODEL = "claude-opus-5-5"
